# Needed for Spotify playlist import (URL) and "Log in with Spotify".
# Create a free app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Add this exact URL to your Spotify app's Redirect URIs.
# Spotify rejects "localhost" and plain http; use the 127.0.0.1 loopback address.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# Where the Python music service runs
MUSIC_SERVER=http://127.0.0.1:8000